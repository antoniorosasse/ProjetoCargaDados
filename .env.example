# ============================================================
# Copie este arquivo para .env e preencha com valores reais.
# NUNCA commite o .env de verdade.
# ============================================================

# Django
SECRET_KEY=troque-por-uma-chave-secreta-longa
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# AS/400 (DB2) - obrigatorio
AS400_HOST=pub400.com
AS400_USER=seu_usuario
AS400_PASSWORD=sua_senha
AS400_LIBRARY=SUA_LIBRARY
AS400_JDBC_JAR=/caminho/absoluto/para/lib/jt400.jar

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DB=bancocnpj
PG_USER=seu_usuario
PG_PASSWORD=sua_senha

# MongoDB
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=cnpj
MONGO_USER=seu_usuario
MONGO_PASSWORD=sua_senha

# ============================================================
# Publicacao na VPS (opcional: vazio desabilita a secao do admin)
# ============================================================
# Acesso sempre por SSH. A senha do banco de producao NAO vai aqui: o
# psql/pg_restore da VPS usam o ~/.pgpass do usuario remoto.
PUBLICACAO_SSH=usuario@host-da-vps
# host:porta:banco:usuario (formato do .pgpass, mas do lado da VPS)
PUBLICACAO_PG=localhost:5432:bancocnpj:arosasse
# Servico systemd que e parado/religado na janela do restore
PUBLICACAO_SERVICO=cnpj
# Onde ficam os dumps por tabela (um subdiretorio por rotulo); ~8 GB no lote
PUBLICACAO_DUMP_DIR=/caminho/com/espaco/pubs
# Pasta na VPS que recebe dumps, script e log
PUBLICACAO_REMOTO=carga
# Restore/indices em paralelo
PUBLICACAO_JOBS=4

